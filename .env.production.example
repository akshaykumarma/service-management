# Production settings for docker-compose.prod.yml. Copy to .env on the server and fill in.
# Generate each secret with:  openssl rand -base64 32   (a different one for each)

# Your domain, pointing (DNS A record) at the server's public IP. No https://, no slash.
APP_DOMAIN=service.example.com

POSTGRES_PASSWORD=
AUTH_SECRET=
OTP_HASH_SECRET=
SESSION_IDLE_TIMEOUT_HOURS=8

# Email for password resets (e.g. Gmail with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# WhatsApp Cloud API (docs/DEPLOY-ORACLE.md, Part 5)
WHATSAPP_PROVIDER=meta
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# The Meta app's App Secret (App settings > Basic) — checks delivery-status callbacks.
WHATSAPP_WEBHOOK_SECRET=
# Any phrase; type the same one as the webhook "Verify token" in Meta.
WHATSAPP_VERIFY_TOKEN=
# Language code your templates were approved in (e.g. en, en_US).
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Only if you named a Meta template differently from docs/WHATSAPP-TEMPLATES.md, e.g.:
# WHATSAPP_TEMPLATE_OTP=my_delivery_code
