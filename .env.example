# PostgreSQL connection string
DATABASE_URL=postgres://service_management:service_management@localhost:5432/service_management

# Secret used to sign session tokens / CSRF tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Hours of inactivity before a session expires (default 8, per constitution)
SESSION_IDLE_TIMEOUT_HOURS=8

# SMTP transport for password-reset emails (any SMTP-compatible provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Service Management <no-reply@example.com>"

# Base URL used to build password-reset links
APP_BASE_URL=http://localhost:3000

# MinIO (S3-compatible) object storage for intake photos
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=service_management
MINIO_SECRET_KEY=service_management_minio
MINIO_BUCKET=intake-photos

# Meta WhatsApp Business Cloud API (a self-hosted mock in dev/test — never the real
# endpoint outside production; see tests/helpers/mock-whatsapp-server.ts)
WHATSAPP_API_URL=http://localhost:4570
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=change-me

# Secret used to key OTP code hashing (HMAC-SHA256, research.md §2). Generate with:
# openssl rand -base64 32
OTP_HASH_SECRET=
